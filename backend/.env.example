APP_NAME=ДомПульс API
DATABASE_URL=postgresql+psycopg://dompulse:CHANGE_ME@localhost:5432/dompulse
# Same bot token as the chatbot. Never expose it in NEXT_PUBLIC variables.
BOT_TOKEN=
LOCAL_LOGIN_ENABLED=false
# Random server-only secret, required only for local login.
LOCAL_SESSION_SECRET=
MAX_AUTH_AGE_SECONDS=3600
POSTGRES_PASSWORD=CHANGE_ME
COMPOSE_DATABASE_URL=postgresql+psycopg://dompulse:CHANGE_ME@db:5432/dompulse
# false only for local HTTP; true for HTTPS deployment.
SESSION_COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
