  "components": {
    "schemas": {
      "AccountResponse": {
        "properties": {
          "number": {
            "type": "string",
            "title": "Number"
          },
          "invoiceNumber": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Invoicenumber"
          },
          "area": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Area"
          },
          "residents": {
            "type": "integer",
            "title": "Residents"
          },
          "period": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Period"
          },
          "readingPeriod": {
            "type": "string",
            "title": "Readingperiod"
          },
          "due": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Due"
          },
          "charges": {
            "items": {
              "$ref": "#/components/schemas/Charge"
            },
            "type": "array",
            "title": "Charges"
          },
          "meters": {
            "items": {
              "$ref": "#/components/schemas/MeterResponse"
            },
            "type": "array",
            "title": "Meters"
          }
        },
        "type": "object",
        "required": [
          "number",
          "invoiceNumber",
          "area",
          "residents",
          "period",
          "readingPeriod",
          "due",
          "charges",
          "meters"
        ],
        "title": "AccountResponse"
      },
      "ApartmentPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ApartmentResponse"
            },
            "type": "array",
            "title": "Items"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          }
        },
        "type": "object",
        "required": [
          "items",
          "next_cursor"
        ],
        "title": "ApartmentPage"
      },
      "ApartmentResponse": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "house_id": {
            "type": "integer",
            "title": "House Id"
          },
          "number": {
            "type": "integer",
            "title": "Number"
          },
          "entrance": {
            "type": "integer",
            "title": "Entrance"
          },
          "floor": {
            "type": "integer",
            "title": "Floor"
          }
        },
        "type": "object",
        "required": [
          "id",
          "house_id",
          "number",
          "entrance",
          "floor"
        ],
        "title": "ApartmentResponse"
      },
      "CameraFrame": {
        "properties": {
          "src": {
            "type": "string",
            "title": "Src"
          },
          "capturedAt": {
            "type": "string",
            "format": "date-time",
            "title": "Capturedat"
          }
        },
        "type": "object",
        "required": [
          "src",
          "capturedAt"
        ],
        "title": "CameraFrame"
      },
      "CameraResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "status": {
            "type": "string",
            "enum": [
              "online",
              "maintenance",
              "unavailable"
            ],
            "title": "Status"
          },
          "note": {
            "type": "string",
            "title": "Note"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "status",
          "note"
        ],
        "title": "CameraResponse"
      },
      "Charge": {
        "properties": {
          "title": {
            "type": "string",
            "title": "Title"
          },
          "quantity": {
            "type": "string",
            "title": "Quantity"
          },
          "tariff": {
            "type": "string",
            "title": "Tariff"
          },
          "amount": {
            "type": "integer",
            "title": "Amount"
          }
        },
        "type": "object",
        "required": [
          "title",
          "quantity",
          "tariff",
          "amount"
        ],
        "title": "Charge"
      },
      "CreateIssue": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1,
            "title": "Title"
          },
          "description": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Description"
          },
          "category": {
            "$ref": "#/components/schemas/IssueCategory"
          },
          "place": {
            "$ref": "#/components/schemas/Location"
          },
          "request_id": {
            "type": "string",
            "format": "uuid",
            "title": "Request Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title",
          "description",
          "category",
          "place",
          "request_id"
        ],
        "title": "CreateIssue"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status",
            "default": "ok"
          }
        },
        "type": "object",
        "title": "HealthResponse"
      },
      "HouseResponse": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "address": {
            "type": "string",
            "title": "Address"
          },
          "entrances_count": {
            "type": "integer",
            "title": "Entrances Count"
          },
          "floors_count": {
            "type": "integer",
            "title": "Floors Count"
          },
          "apartments_per_floor": {
            "type": "integer",
            "title": "Apartments Per Floor"
          }
        },
        "type": "object",
        "required": [
          "id",
          "address",
          "entrances_count",
          "floors_count",
          "apartments_per_floor"
        ],
        "title": "HouseResponse"
      },
      "IssueCategory": {
        "type": "string",
        "enum": [
          "water",
          "heating",
          "electricity",
          "elevator",
          "entrance",
          "yard",
          "garbage",
          "security",
          "other"
        ],
        "title": "IssueCategory"
      },
      "IssueHistory": {
        "properties": {
